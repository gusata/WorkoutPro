{
  "name": "workoutpro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve:static": "node scripts/serve-static.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "node scripts/run-playwright.mjs app.spec.ts",
    "pretest:visual": "npm run build",
    "test:visual": "node scripts/run-playwright.mjs visual.spec.ts",
    "pretest:visual:update": "npm run build",
    "test:visual:update": "node scripts/run-playwright.mjs visual.spec.ts --update-snapshots",
    "test:device": "node scripts/run-device-e2e.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "test:supabase:staging": "node scripts/verify-supabase-staging.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "android": "npm run build && npx cap sync android && powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:JAVA_HOME='C:\\Program Files\\Android\\Android Studio\\jbr'; $env:ANDROID_HOME=Join-Path $env:LOCALAPPDATA 'Android\\Sdk'; npx cap run android\"",
    "android:sync": "npm run build && npx cap sync android",
    "android:check": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:JAVA_HOME='C:\\Program Files\\Android\\Android Studio\\jbr'; $env:ANDROID_HOME=Join-Path $env:LOCALAPPDATA 'Android\\Sdk'; Set-Location android; .\\gradlew.bat --no-daemon testDebugUnitTest lintDebug\"",
    "android:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:JAVA_HOME='C:\\Program Files\\Android\\Android Studio\\jbr'; $env:ANDROID_HOME=Join-Path $env:LOCALAPPDATA 'Android\\Sdk'; Set-Location android; .\\gradlew.bat --no-daemon bundleRelease\"",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:install": "npm run android:apk && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capgo/capacitor-health": "^8.12.4",
    "@supabase/supabase-js": "^2.110.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.3",
    "lucide-react": "^1.17.0",
    "next": "16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "agentation": "^3.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
